# Export these in your shell; the app does not automatically load this file.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Choose anthropic (default) or gemini.
RELOOP_VISION_PROVIDER=anthropic
# Use a vision/structured-output model ID available in the selected provider account.
RELOOP_VISION_MODEL=
# Explicitly enables unresearched fixture prices for local demos only.
RELOOP_ALLOW_DEMO_PRICES=1
# Optional absolute path; defaults to data/price_book.csv in this checkout.
# RELOOP_PRICE_BOOK=/path/to/researched/price_book.csv
