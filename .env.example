# Cerebras-only live pipeline. Never commit the real key.
CEREBRAS_API_KEY=
CEREBRAS_VISION_MODEL=gemma-4-31b
CEREBRAS_ANALYTICS_MODEL=gpt-oss-120b
# Use zai-glm-4.7 above to swap the text analytics model.
CEREBRAS_ANALYTICS_ENABLED=true
CEREBRAS_MODEL_INTERVAL_MS=12000
CEREBRAS_FRAMES_PER_REQUEST=5
VISION_BACKEND=cerebras

# Server integration.
PORT=3000
HOST=0.0.0.0
CORS_ORIGIN=*

# Campus WebRTC fallback (optional, but recommended for client-isolated Wi-Fi).
# Create a Cloudflare Realtime TURN key, then keep both values server-side.
# The server issues short-lived, pairing-session ICE credentials to the browsers.
# CLOUDFLARE_TURN_KEY_ID=
# CLOUDFLARE_TURN_API_TOKEN=
# CLOUDFLARE_TURN_TTL_SECONDS=900
#
# Alternative static STUN/TURN configuration for another provider:
# WEBRTC_ICE_SERVERS_JSON=[{"urls":"turn:turn.example.edu:3478","username":"...","credential":"..."}]

# Explicitly fake camera extraction for UI/network plumbing tests only.
# VISION_BACKEND=fixture
# ALLOW_FIXTURE_LIVE=true
