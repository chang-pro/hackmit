# ReLoop environment. Copy to .env (gitignored); npm start loads it if present.
# Every value here is optional -- the server runs without any of them, with the
# features that need them switched off. Never commit real keys.

# ── Identification and pricing (the live feed) ───────────────────────────────
# right.codes issues a separate key per model channel; the Gemini channel does
# NOT accept RIGHTCODES_API_KEY. Without a key, pricing reports an error.
RIGHTCODES_KEY_GEMINI=
# RIGHTCODES_API_KEY=            # Claude channel
# RIGHTCODES_ITEMS_MODEL=gemini-3.8-flash

# ── Shopify: where approved items go live ───────────────────────────────────
# Admin API access token (shpat_...) from the store's admin -> Apps ->
# Develop apps, with write_products, read_products, write_publications and
# read_publications. The publications scopes are what put a product on the
# storefront; without them its product URL 404s. Reissue the token after
# changing scopes -- an existing token keeps the scopes it was issued with.
# With no token, or DRY_RUN=1, publishing is simulated and labelled "dry run".
SHOPIFY_STORE_DOMAIN=reloop-dev.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
# DRY_RUN=1

# ── Facebook Marketplace drafts (opt-in, needs the muse.ai Chrome bridge) ────
# See facebook-marketplace/README.md. Off unless this is 1.
# RELOOP_MARKETPLACE_DRAFTS=1
# PUBLIC_BASE_URL=https://your-tunnel.example   # so muse.ai can fetch photos
# MUSE_CHAT=post items to facebook marketplace

# ── Persistence ─────────────────────────────────────────────────────────────
# Without these, plans, listings and events are lost on restart.
# RELOOP_MARKET_FILE=data/market_state.json
# RELOOP_EVENTS_FILE=data/events.jsonl

# ── Buyer agent (scripts/buyer.js) ──────────────────────────────────────────
# Falls back to scripted bargaining when no key is set. Reuses the keys above,
# or set one of these explicitly.
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# RELOOP_URL=http://localhost:3000

# ── Server ──────────────────────────────────────────────────────────────────
# PORT=3000
# RELOOP_LOG_REQUESTS=1          # log every inbound request with its source
# RELOOP_MIN_LISTABLE_USD=15     # below this, the planner proposes donation
